:root {
  --el-color-primary #4975c6
  --el-color-primary-light-3 #5482d3
  --el-color-primary-light-5 #a0bbff
  --el-color-primary-light-7 #c6d3ff
  --el-color-primary-light-8 #d9e2ff
  --el-color-primary-light-9 #ecefff
}


// 暗色模式下把 Element Plus 的容器 / 边框 / 文字变量对齐到项目三级背景，
// 消除 Element Plus 默认的 #141414 黑块，并保证文字对比度达到 WCAG AA。
html.dark {
  --el-bg-color var(--background-color-2)
  --el-bg-color-overlay var(--background-color-3)
  --el-fill-color-blank var(--background-color-2)
  --el-fill-color-light #34343c
  --el-fill-color-lighter #3a3a44
  --el-border-color var(--border-color)
  --el-border-color-light var(--border-color-light)
  --el-border-color-lighter var(--border-color-lighter)
  --el-text-color-primary var(--text-color-2)
  --el-text-color-regular var(--text-color)
  --el-text-color-secondary var(--text-color-4)
  --el-color-primary-light-9 #2b3a55

  // 设置页折叠分组：暗色下让分组卡片浮起（亮于主内容区），并补边框与 hover 反馈。
  // 只覆盖配色，不撑高盒模型：固定 48rem 与浅色模式的 min-height: 48px 对齐，
  // 上下 padding 保持 0，因此两种模式行高完全一致。仅作用于暗色。
  .el-collapse {
    border-top none
    border-bottom none
  }

  .el-collapse-item__header {
    height 48rem
    padding 0 16rem
    color var(--text-color-2)
    background var(--background-color-3)
    border 1rem solid var(--border-color)
    border-radius 12rem
    transition background-color 0.2s ease, border-color 0.2s ease

    &:hover {
      background var(--background-color-hover)
      border-color var(--el-color-primary-light-3)
    }
  }
}

.el-message__icon {
  width 15rem
  height 15rem

  svg {
    width 15rem
    height 15rem
  }
}
